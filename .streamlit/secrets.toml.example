# Safe example configuration. This file contains no real credentials.
#
# Demo Mode is permanent, free, and requires no secrets or external service.
INFERENCE_PROVIDER = "demo"

# To use a local Ollama installation during development, copy this file to
# `.streamlit/secrets.toml`, change the provider to "ollama", and uncomment
# the settings below. Never use localhost Ollama for Community Cloud.
#
# INFERENCE_PROVIDER = "ollama"
# OLLAMA_BASE_URL = "http://localhost:11434"
# OLLAMA_MODEL = "llama3.2"
# OLLAMA_HEALTH_TIMEOUT = 2.5
# OLLAMA_GENERATION_TIMEOUT = 120.0

# Future cloud providers must be explicitly implemented and approved before
# use. If one is added later, put its fake placeholder here and store the real
# value only in local secrets or Streamlit Community Cloud's Secrets settings.
